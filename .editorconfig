root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

ktlint_standard_filename = enabled

# Spectron's namespace files are named for the namespace they expose -- ns/Traces.kt
# is reached as spectron.traces -- so the type name is deliberately the longer one.
[spectron/src/*/kotlin/com/surrealdb/kotlin/spectron/ns/*.kt]
ktlint_standard_filename = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
